generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma_client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator erd {
  provider = "prisma-erd-generator"
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
}
